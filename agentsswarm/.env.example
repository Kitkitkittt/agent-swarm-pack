BRIDGE_PORT=7799
# Required unless ALLOW_UNSECURED_BRIDGE=true for local development only.
BRIDGE_SECRET=
ALLOW_UNSECURED_BRIDGE=false

TASK_EXECUTION_BACKEND=standalone
CONNECTOR_BACKEND=none
# Fixed operator-configured executable; task JSON arrives on stdin, never a shell.
STANDALONE_TASK_RUNNER_COMMAND=
STANDALONE_TASK_RUNNER_ARGS=[]
STANDALONE_TASK_RUNNER_TIMEOUT_MS=300000
STANDALONE_TASK_RUNNER_CONCURRENCY=2
# Comma-separated absolute roots; empty uses DEFAULT_PROJECT_PATH or package root.
STANDALONE_ALLOWED_PROJECT_ROOTS=
CONNECTOR_API_KEY=
REMOTE_INBOX_SECRET=

SWARMCLAW_URL=http://127.0.0.1:3456
SWARMCLAW_ACCESS_KEY=

AGENTSSWARM_API_URL=http://127.0.0.1:8790
# Optional. If empty, AgentSwarm auto-bootstraps local auth via /api/auth/session.
AGENTSSWARM_AUTH_TOKEN=
INBOX_WEBHOOK_SECRET=

DEFAULT_PROJECT_PATH=
DEFAULT_PLATFORM=telegram
DEFAULT_ACCOUNT_ID=primary
DEFAULT_MANAGER_CONNECTOR_ID=
DEFAULT_MANAGER_CHANNEL_ID=
DEFAULT_MANAGER_PLATFORM=telegram
DEFAULT_MANAGER_ACCOUNT_ID=primary
DEFAULT_MANAGER_THREAD_ID=

STATUS_RELAY_ENABLED=true
STATUS_RELAY_MANAGED_ONLY=true
STATUS_RELAY_INTERVAL_MS=6000
CHANNEL_ROUTE_TTL_MS=604800000
PROJECT_ROUTE_TTL_MS=604800000
TASK_ROUTE_TTL_MS=259200000
PROJECT_PATH_CACHE_TTL_MS=300000

# Request safeguards.
MAX_INGEST_BODY_BYTES=65536
INGEST_MESSAGE_ID_TTL_MS=300000
HTTP_RETRY_MAX_ATTEMPTS=2
HTTP_RETRY_BASE_DELAY_MS=250

# For $ directives, skip planned meeting and apply immediately.
DIRECTIVE_SKIP_PLANNED_MEETING=true

# # command mode:
# - hybrid: create task on board, then run immediately
# - board_only: create task only (no immediate run)
TASK_COMMAND_MODE=hybrid

# Compact packs stay below the 8-agent cap.
DEFAULT_COMPACT_PACK=software-6
DEFAULT_PROVIDER_PROFILE=codex-main
COMPACT_AGENT_LIMIT=8
ENFORCE_COMPACT_PROJECT_SCOPE=true

# Supported platforms and required CLI tools used by doctor/preflight.
AGENTSSWARM_SUPPORTED_PLATFORMS=telegram,discord,whatsapp,cli
AGENTSSWARM_REQUIRED_CLI_TOOLS=openclaw,codex

# Optional provider and pack overrides (JSON strings).
AGENTSSWARM_PROVIDER_PROFILES_JSON=
AGENTSSWARM_PACKS_JSON=

# Optional static route tables.
# PROJECT_ROUTE_MAP_JSON={"C:\\repo\\project-a":{"connectorId":"abc","channelId":"123","platform":"discord","accountId":"primary"}}
PROJECT_ROUTE_MAP_JSON=
# CHANNEL_ROUTE_MAP_JSON={"telegram|primary|founder-room|-":{"connectorId":"abc","channelId":"founder-room","platform":"telegram","accountId":"primary"}}
CHANNEL_ROUTE_MAP_JSON=

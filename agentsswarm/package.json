{
  "name": "agentsswarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "test:web": "node --test test/web-http.test.js",
    "build:web": "npm --prefix ui run build",
    "test:perf": "node scripts/perf-smoke.mjs",
    "cli": "node src/cli.js",
    "preflight": "node src/cli.js preflight",
    "startup-check": "node src/cli.js preflight",
    "sync-env": "node scripts/bootstrap-env.mjs",
    "sync-env:strict": "node scripts/bootstrap-env.mjs --strict",
    "check": "node scripts/check.mjs"
  }
}
